# Domínio público — usado em metadataBase e og:image.
# Sem isso o og:image aponta para um domínio placeholder.
NEXT_PUBLIC_SITE_URL=https://seudominio.com.br

# ── Formulário de contato ────────────────────────────────────
# Enquanto RESEND_API_KEY não estiver definida, /api/contact devolve 501
# e o formulário cai automaticamente para abrir o app de e-mail do visitante.
# Com a chave definida, o envio acontece no servidor.
# Crie a chave em https://resend.com (plano gratuito serve).
RESEND_API_KEY=
CONTACT_TO_EMAIL=isam250500@gmail.com
# Precisa ser um domínio verificado no Resend. O padrão abaixo funciona para teste.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
